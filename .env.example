# Copy to .env and fill in real values:
#   cp .env.example .env
# Windows: copy .env.example .env

APP_PORT=8080

# External MySQL (VM must reach this host, e.g. Tailscale)
SPRING_DATASOURCE_URL=jdbc:mysql://100.82.181.31:3306/weather?serverTimezone=UTC&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=weather
SPRING_DATASOURCE_PASSWORD=your_db_password

SPRING_JWT_SECRET=your_jwt_secret_at_least_32_chars

OPENWEATHERMAP_KEY=your_openweathermap_api_key
GEMINI_KEY=your_gemini_api_key
